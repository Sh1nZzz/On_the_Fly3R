# on_the_fly3r collaboration baseline
#
# This repository tracks the on-the-fly multi-VFM reconstruction framework.
# External model repositories, checkpoints, datasets, and generated artifacts
# stay local and are documented in README/setup.sh instead.

# Git metadata backups and local history experiments
.git_backup/
.git_backup*/

# Accidental local output directory named a single space
/\ /

# External repositories cloned next to this project
/Pi3/
/reloc3r/
/SupScene/
/LightGlue/
/map-anything/
/salad/
/vggt/
/vggt-compressed/
/vggt-omega/

# Legacy SALAD retrieval wrapper
/vggt_slam/

# Local-only scripts not included in the on_the_fly3r GitHub baseline
/main.py
/run.bash
/interframe_solver.py
/rig_solver.py
/eval_vis_pcd_traj.py
/summary_geom.py
/summary_traj.py
/online_debug_viewer.py
/evaluate_raw_model_poses.py
/export_pi3_batch_frame_clouds.py
/npz_to_ply.py
/run_reloc3r_sequence_poses.py
/batch_evaluate_runs.py
/evaluate_pairwise_relative_pose.py
/evaluate_point_cloud_metrics.py
/evaluate_reloc3r_direction_graph.py
/scripts/
/tests/test_low_memory_exports.py
/tests/test_pose_graph_refinement_and_debug.py
/*.xlsx

